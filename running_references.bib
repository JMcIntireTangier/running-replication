@misc{berge_fixest_2026,
	title = {fixest: {Fast} {Fixed}-{Effects} {Estimations}},
	copyright = {GPL-3},
	shorttitle = {fixest},
	url = {https://cran.r-project.org/web/packages/fixest/index.html},
	abstract = {Fast and user-friendly estimation of econometric models with multiple fixed-effects. Includes ordinary least squares (OLS), instrumental variables (IV), generalized linear models (GLM), maximum likelihood estimation (ML), and the negative binomial. The core of the package is based on optimized parallel C++ code, scaling especially well for large data sets. The method to obtain the fixed-effects coefficients is based on Bergé, Butts, McDermott (2026) {\textless}doi:10.48550/arXiv.2601.21749{\textgreater}. Further provides tools to export and view the results of several estimations with intuitive design to change the standard-errors.},
	urldate = {2026-05-11},
	author = {Berge, Laurent and Krantz, Sebastian and McDermott, Grant and Lenth, Russell and Butts, Kyle},
	month = may,
	year = {2026},
	keywords = {CausalInference, Econometrics},
}
