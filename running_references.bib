@article{munthali_transforming_2024-1,
	title = {Transforming lives: biofortified beans reach 22.14 million people in {Africa}},
	shorttitle = {Transforming lives},
	url = {https://hdl.handle.net/10568/141765},
	abstract = {Nutrition-sensitive agriculture interventions were mainstreamed through the Pan-Africa Bean Research Alliance’s (PABRA) bean corridors approach between 2017 and 2023. These interventions have increased the number of women and men accessing and consuming biofortified high-iron beans (HIBs) and value-added bean products in Central, East, and Southern Africa from 720,000 to 22,14 million people. The continued adoption of HIBs and value-added bean products across 18 PABRA countries is attributed to complimentary projects that are promoting HIB release and mainstreaming through community outreach, school feeding programs, and value-addition and commercialization interventions.},
	language = {en},
	urldate = {2025-08-25},
	author = {Munthali, Justice and Rubyogo, Jean Claude},
	year = {2024},
}

@article{saikat_effectiveness_2024-1,
	title = {Effectiveness of {Millet}–{Pulse}–{Groundnut} {Based} {Formulations} in {Improving} the {Growth} of {Pre}-{School} {Tribal} {Children} in {Telangana} {State}, {India}},
	volume = {16},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2072-6643},
	url = {https://www.mdpi.com/2072-6643/16/6/819},
	doi = {10.3390/nu16060819},
	abstract = {A community-level nutritional intervention was implemented among tribal children (3 to 6 years of age) in Telangana, India. The one-year intervention involved six nutrient-rich formulations of millet–pulse–groundnut-based products suited to local taste preferences. Anthropometric measurements of height, weight, and mid-upper-arm circumference (MUAC) along with haemoglobin (Hb) levels were monitored at baseline and endline. The treatment group showed considerable gains in height (3.2 cm), weight (1.68 kg), and MUAC (0.33 cm) over the control group. The paired t-test indicated significant differences (p {\textbackslash}textless 0.01) between the pre- and post-intervention anthropometric measurements. Positive shifts were observed in terms of wasting (WHZ; −1.2 ± 1.3 to −0.9 ± 1), stunting (HAZ; −1.8 ± 1.6 to −0.3 ± 1.3), and underweight (WAZ; −1.9 ± 1.2 to −0.7 ± 1) in the treatment group. The Hb levels in the treatment group also improved significantly from 9.70 ± 0.14 g/dL (moderately anaemic) to 11.08 ± 0.13 g/dL (non-anaemic). Post-intervention focus group discussions (FGDs) involving mothers and teachers confirmed these positive impacts. Thus, a nutritional intervention formulated using climate-resilient millets, pulses, and groundnuts promotes dietary diversity and improves the nutrition and health statuses of children.},
	language = {en},
	number = {6},
	urldate = {2025-08-25},
	journal = {Nutrients},
	author = {Saikat, Datta Mazumdar and Victor, Afari-Sefa and Aravazhi, Selvaraj and Priyanka, Durgalla and Anitha, Seetha and Tamilselvi, Nedumaran and Divya Nancy, Gaddam and Harshvardhan, Mane and Suchiradipta, Bhattacharjee and Nedumaran, Swamikannu and Anitha, Raman and Roopa, Banerjee and Jyosthnaa, Padmanabhan and Disha, Bose},
	month = jan,
	year = {2024},
	keywords = {millets, nutrition intervention, pre-school children, ready-to-cook food, ready-to-eat food, sorghum, Impact star},
	pages = {819},
	annote = {Publisher: Multidisciplinary Digital Publishing Institute},
	file = {Full Text PDF:C\:\\Users\\jmm19\\Zotero\\storage\\GC2GPG2F\\Saikat et al. - 2024 - Effectiveness of Millet–Pulse–Groundnut Based Formulations in Improving the Growth of Pre-School Tri.pdf:application/pdf},
