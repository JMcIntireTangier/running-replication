@article{arouna_adoption_2023,
	title = {The adoption and impacts of improved parboiling technology for rice value chain upgrading on the livelihood of women rice parboilers in {Benin}},
	issn = {2571-581X},
	url = {https://hdl.handle.net/10568/130637},
	doi = {10.3389/fsufs.2023.1066418},
	abstract = {Food insecurity and child malnutrition remain persistent problems in sub-Saharan Africa. Rice is a staple food for more than half of the world’s population. However, white rice is poor in micronutrients and records higher glycemic values compared to parboiled rice. An improved parboiling system called “Grain quality enhancer, Energy-efficient and durable Material” (GEM in short) allows the processing of quality rice with better physical and nutritional properties compared to traditional systems. This paper assessed the drivers and impact of the adoption of the GEM system on women’s livelihoods. A total of 822 rice women parboilers were randomly sampled and interviewed in Benin, in regions where the GEM system was introduced. We employed the endogenous switching regression model (ESR) to assess the impact of the GEM system. We found evidence that adoption of the GEM system increased women parboilers’ rice output rate (dehulling return), income and food security and reduced poverty. The impact of the GEM system is estimated at 14.38 kg of milled rice per 100 kg of paddy (21.46\%), equivalent to US\$ 7.25 of additional income (17.77\%). A significantly lower poverty rate of 26\% was found among households due to the adoption of the GEM system. These results are supported by women’s perceptions that the output rate, better nutritional value and reduction of broken rice during dehulling are major advantages of the improved parboiling system. Policy actions such as training of local fabricators and credit options are required for out-scaling and sustainability of the improved parboiling system.},
	language = {en},
	urldate = {2025-08-22},
	author = {Arouna, A. and Aboudou, R. and Ndindeng, S. A.},
	year = {2023},
	annote = {Publisher: Frontiers Media},
	file = {Full Text:C\:\\Users\\jmm19\\Zotero\\storage\\NW9EVS9L\\Arouna et al. - 2023 - The adoption and impacts of improved parboiling technology for rice value chain upgrading on the liv.pdf:application/pdf},
}

@article{arouna_does_2024,
	title = {Does {Adoption} of {Improved} {Variety} {Encourage} {Farmers} to {Invest} in {Modern} {Inputs} and {Use} {Good} {Practices}? {Evidence} from {Rice} {Farmers} in {Guinea}},
	shorttitle = {Does {Adoption} of {Improved} {Variety} {Encourage} {Farmers} to {Invest} in {Modern} {Inputs} and {Use} {Good} {Practices}?},
	url = {https://hdl.handle.net/10568/170088},
	doi = {10.1017/aae.2024.27},
	abstract = {Iron toxicity is one of the constraints limiting rice production in Africa. This study used a randomized controlled trial to assess the impact of an iron toxicity-tolerant variety, named ARICA 6, on different outcomes and investment in modern inputs by smallholder farmers. Two rounds of data were collected from 520 rice-farming households in Guinea. Results showed that the use of ARICA 6 increased rice yield by 330 kg ha−1 and net income by US\$ 120 ha−1 . However, adoption of improved variety may not be enough to crowd in investment in modern inputs because farmers face other constraints.},
	language = {en},
	urldate = {2025-08-22},
	author = {Arouna, A. and Barry, M. L. and Kamano, P. and Yabi, J. A.},
	year = {2024},
	keywords = {Impact obelus},
	file = {Full Text PDF:C\:\\Users\\jmm19\\Zotero\\storage\\NMCZQQT6\\Arouna et al. - 2024 - Does Adoption of Improved Variety Encourage Farmers to Invest in Modern Inputs and Use Good Practice.pdf:application/pdf},
}

@article{aryal_managing_2022,
	title = {Managing drought risks with drought-stress tolerant rice varieties and its impacts on yield and production risk: {A} case of {Nepal}},
	volume = {7},
	issn = {2667-0100},
	shorttitle = {Managing drought risks with drought-stress tolerant rice varieties and its impacts on yield and production risk},
	url = {https://www.sciencedirect.com/science/article/pii/S2667010022000634},
	doi = {10.1016/j.envc.2022.100503},
	abstract = {Managing drought risk is one of the most critical issues for rice farmers as its production requires a large amount of water compared to other crops. Drought-stress tolerant rice varieties (DSTRV) are thus important to minimize production loss and yield variability. Therefore, this study empirically examines the impact of DSTRV on rice yield and downside production risk. For the empirical analyses, this study uses data from 1,576 rice plots operated by 631 farm households in the Terai region of Nepal. To examine the impact of DSTRV on rice yield, an endogenous switching regression model is applied, while for assessing production risk, we applied a flexible moment-based specification of a stochastic production function. Results show that 80\% of the farm households in the study area mentioned drought as the major climate risk, and about 31.35\% of the sampled farmers used DSTRV in their farms. The average yield difference between the adopter and non-adopters of DSTRV is about 22.84\%, and the downside production risk (i.e., the probability of crop failure) among adopters is reduced by almost 80\%. Furthermore, if the non-adopters had adopted the DSTRV, they would have increased their rice yield by 20\% and reduced the downside production risks by 47.4\%. With these benefits, there is an enormous scope to upscale the adoption of DSTRV in Nepal as an ex-ante adaptation measure to drought risk in rice farming. Proper dissemination of such varieties and enhancing farmers’ knowledge and capacity to apply such measures are crucial steps to minimize the risks of loss due to drought.},
	urldate = {2025-08-22},
	journal = {Environmental Challenges},
	author = {Aryal, Jeetendra Prakash and Rahut, Dil Bahadur and Acharya, Sanjaya},
	year = {2022},
	keywords = {Drought-stress tolerant rice variety, Impact on rice yield, Nepal, Production risks, Terai, Impact star},
	pages = {100503},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\jmm19\\Zotero\\storage\\6Q3R5MK6\\Aryal et al. - 2022 - Managing drought risks with drought-stress tolerant rice varieties and its impacts on yield and prod.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\jmm19\\Zotero\\storage\\A889RQKS\\S2667010022000634.html:text/html;ScienceDirect Snapshot:C\:\\Users\\jmm19\\Zotero\\storage\\9SC2QMW8\\S2667010022000634.html:text/html},
}

@article{aung_impact_2021,
	title = {The impact of sustainable aquaculture technologies on the welfare of small-scale fish farming households in {Myanmar}},
	issn = {1365-7305},
	url = {https://hdl.handle.net/20.500.12348/5067},
	doi = {10.1080/13657305.2021.2011988},
	abstract = {This study analyzed the determinants and potential impacts of the adoption of sustainable aquaculture (SA) technologies on the welfare of small-scale aquaculture (SSA) households in Myanmar using an endogenous switching regression model. Welfare is measured by fish productivity and fish income per cycle and Household Dietary Diversity Score. Our analysis revealed that distance to the sale-point, membership in farmers’ organizations, awareness of pond maintenance benefits, access to information through private extension services, and location were the main drivers behind adopting SA technologies. Results showed that adopting SA technologies increases welfare outcomes of SSA households; however, the non-adopters stand to benefit the most in terms of an increase in welfare outcomes if they adopt the technologies. Our research findings suggested that policies targeted at raising SSA households’ income and dietary diversity can be realized through interventions to raise farmer’s awareness, adoption, and technical know-how about the SA technologies.},
	language = {en},
	urldate = {2025-08-22},
	author = {Aung, Y. M. and Khor, L. and Tran, N. and Akester, M. J. and Zeller, M.},
	year = {2021},
	keywords = {Impact star},
	annote = {Publisher: Taylor and Francis},
	file = {Snapshot:C\:\\Users\\jmm19\\Zotero\\storage\\FNS4BR75\\5067.html:text/html;Snapshot:C\:\\Users\\jmm19\\Zotero\\storage\\KWJS2BUN\\5067.html:text/html},
}

@article{awotide_evaluating_2022,
	title = {Evaluating the heterogeneous impacts of adoption of climate-smart agricultural technologies on rural households' welfare in {Mali}},
	issn = {2077-0472},
	url = {https://hdl.handle.net/10568/125568},
	doi = {10.3390/agriculture12111853},
	abstract = {Climate change is negatively affecting agricultural production in the Sahel region. Climate-Smart Agricultural Technologies (CSATs) are disseminated to reduce these negative effects, and particularly those on resource-poor farm households. This article investigates the distributional impacts of the adoption of CSAT on-farm households’ welfare using a dataset that covers four regions, 32 communes, 320 villages, and 2240 households in Mali. Using an instrumental variable quantile treatment effects model, the paper addresses the potential endogeneity arising from the selection bias and the heterogeneity of the effect across the quantiles of the outcome variables’ distribution. The results show that the adoption of CSAT is positively associated with improved households’ welfare. The farmers’ decision to adopt any CSAT is influenced by access to credit, contact with extension agents, participation in training, access to information through the television, and being a member of any organization such as a cooperative society. Moreover, the effect of the adoption of CSAT on household welfare varies across the different households. In particular, the results show that the impact of the adoption of CSAT on households’ welfare is generally higher for the poorest (farmers located at the bottom tail of the distribution) end of the welfare distribution. The findings, therefore, highlight the pro-poor impact of the adoption of CSAT in the rural Malian context, as well as the need to tailor the CSAT interventions toward specific socio-economic segments of the rural population in Mali.},
	language = {en},
	urldate = {2025-08-22},
	author = {Awotide, B. A. and Ogunniyi, A. and Olagunju, K. O. and Bello, L. O. and Coulibaly, A. Y. and Wiredu, A. N. and Koné, B. and Ahamadou, A. and Manyong, Victor and Abdoulaye, Tahirou},
	year = {2022},
	keywords = {Impact star},
	annote = {Publisher: MDPI},
	file = {Full Text PDF:C\:\\Users\\jmm19\\Zotero\\storage\\FV4HTLMP\\Awotide et al. - 2022 - Evaluating the heterogeneous impacts of adoption of climate-smart agricultural technologies on rural.pdf:application/pdf},
}

@article{bandumula_economic_2022,
	title = {An {Economic} {Evaluation} of {Improved} {Rice} {Production} {Technology} in {Telangana} {State}, {India}},
	volume = {12},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2077-0472},
	url = {https://www.mdpi.com/2077-0472/12/9/1387},
	doi = {10.3390/agriculture12091387},
	abstract = {The demonstrations on improved rice production technology were organized in the Wanaparthy, Nagarkurnool, Yadadri Bhuvanagiri, and Rangareddy districts of Telangana state of India. These demonstrations were organized under the Scheduled Caste Sub Plan of the Indian Institute of Rice Research during the wet season of 2021. The biofortified varieties assume great significance to achieve nutrition security. Hence, the zinc biofortified rice variety, DRR Dhan 48 was demonstrated on the 142 farmer fields and the economic impact of these demonstrations was assessed with the ‘difference in difference’ approach. The results revealed that the production of rice under demonstration plots was more profitable with a higher benefit-to-cost ratio (B:C; 1.9) compared to that of the control plots (1.4). The independent two-sample t-test revealed that the productivity at the control plots was not statistically different from that of the demonstrations plots (p = 0.112) before the project was implemented, however, with the intervention in the form of the demonstration of improved rice production technology, the productivity differed significantly (p = 0.000) for the control and the demonstration plots for the intervention year. The results of the difference in differences estimator revealed that there was a positive impact of demonstrations on the yield of the beneficiaries. The mean productivity of demonstration plots and control plots were 5.52 t/ha and 4.5 t/ha, respectively. The farmers had an additional yield advantage of 22.6\% over the control plots. The results indicated that the adoption of an improved package of practices would enable harnessing higher productivity levels and bridging the yield gaps in similar agroecosystems. Also, the results suggest the practical significance of the popularization of biofortified rice varieties for food and nutritional security.},
	language = {en},
	number = {9},
	urldate = {2025-08-22},
	journal = {Agriculture},
	author = {Bandumula, Nirmala and Rathod, Santosha and Ondrasek, Gabrijel and Pillai, Muthuraman Pitchiah and Sundaram, Raman Meenakshi},
	year = {2022},
	keywords = {biofortified rice variety, difference in difference, DRR Dhan 48, SCSP, Telangana},
	pages = {1387},
	annote = {Publisher: Multidisciplinary Digital Publishing Institute},
	file = {Full Text PDF:C\:\\Users\\jmm19\\Zotero\\storage\\YB6B9Q7X\\Bandumula et al. - 2022 - An Economic Evaluation of Improved Rice Production Technology in Telangana State, India.pdf:application/pdf},
}

